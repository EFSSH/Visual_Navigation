<?xml version="1.0"?>
<!-- SCI-1 L-shaped corner matching sci1.corner_pass (width 1.0 m, inner corner at (-0.5, 0.5)).
     Robot camera rig and worker are kinematic models moved by set_pose for trajectory replay. -->
<sdf version="1.9">
  <world name="corner">
    <physics name="1ms" type="ignored"><max_step_size>0.01</max_step_size><real_time_factor>0</real_time_factor></physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <scene><ambient>0.6 0.6 0.6 1</ambient><background>0.8 0.8 0.8 1</background><shadows>true</shadows></scene>
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows><pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse><specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.3 -0.9</direction>
    </light>
    <model name="ground"><static>true</static><link name="l">
      <collision name="c"><geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry></collision>
      <visual name="v"><geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
        <material><ambient>0.45 0.45 0.42 1</ambient><diffuse>0.45 0.45 0.42 1</diffuse></material></visual>
    </link></model>
    <!-- inner corner block: x < -0.5, y > 0.5 -->
    <model name="inner_block"><static>true</static><pose>-3.5 3.5 1.1 0 0 0</pose><link name="l">
      <collision name="c"><geometry><box><size>6 6 2.2</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>6 6 2.2</size></box></geometry>
        <material><ambient>0.7 0.7 0.68 1</ambient><diffuse>0.7 0.7 0.68 1</diffuse></material></visual>
    </link></model>
    <!-- outer wall of the horizontal leg: y < -0.5 -->
    <model name="outer_h"><static>true</static><pose>-3 -0.6 1.1 0 0 0</pose><link name="l">
      <collision name="c"><geometry><box><size>8 0.2 2.2</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>8 0.2 2.2</size></box></geometry>
        <material><ambient>0.62 0.62 0.6 1</ambient><diffuse>0.62 0.62 0.6 1</diffuse></material></visual>
    </link></model>
    <!-- outer wall of the vertical leg: x > 0.5 -->
    <model name="outer_v"><static>true</static><pose>0.6 3.0 1.1 0 0 0</pose><link name="l">
      <collision name="c"><geometry><box><size>0.2 7.4 2.2</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.2 7.4 2.2</size></box></geometry>
        <material><ambient>0.62 0.62 0.6 1</ambient><diffuse>0.62 0.62 0.6 1</diffuse></material></visual>
    </link></model>

    <!-- robot camera rig; cameras at 0.5 m, set_pose moves the whole model -->
    <model name="robot">
      <pose>-3 0.23 0 0 0 0</pose>
      <link name="base">
        <gravity>false</gravity><kinematic>true</kinematic>
        <visual name="body"><pose>0 0 0.2 0 0 0</pose><geometry><cylinder><radius>0.22</radius><length>0.4</length></cylinder></geometry>
          <material><ambient>0.16 0.47 0.84 1</ambient><diffuse>0.16 0.47 0.84 1</diffuse></material></visual>
        <sensor name="cam87" type="camera">
          <pose>0.23 0 0.5 0 0 0</pose><always_on>true</always_on><update_rate>10</update_rate>
          <topic>cam87</topic>
          <camera><horizontal_fov>1.5184</horizontal_fov>
            <image><width>848</width><height>480</height></image><clip><near>0.05</near><far>20</far></clip></camera>
        </sensor>
        <sensor name="cam120" type="camera">
          <pose>0.23 0 0.5 0 0 0</pose><always_on>true</always_on><update_rate>10</update_rate>
          <topic>cam120</topic>
          <camera><horizontal_fov>2.0944</horizontal_fov>
            <image><width>960</width><height>540</height></image><clip><near>0.05</near><far>20</far></clip></camera>
        </sensor>
      </link>
    </model>

    <!-- worker: Fuel person mesh, moved by set_pose -->
    <include>
      <name>worker</name>
      <pose>0 3 0 0 0 -1.5708</pose>
      <uri>model://casual_female</uri>  <!-- Fuel: OpenRobotics/Casual female, made kinematic; GZ_SIM_RESOURCE_PATH -->
    </include>
  </world>
</sdf>
