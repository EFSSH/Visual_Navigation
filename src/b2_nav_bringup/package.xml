<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>b2_nav_bringup</name>
  <version>0.1.0</version>
  <description>Launch files for B2 navigation and HZ26 station simulation.</description>
  <maintainer email="dministrator@todo.todo">dministrator</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>b2_nav_planning</exec_depend>
  <exec_depend>b2_nav_perception</exec_depend>
  <exec_depend>b2_nav_robot</exec_depend>
  <exec_depend>b2_nav_safety</exec_depend>
  <!-- Mission layer; navigation host only. -->
  <exec_depend condition="$ROS_DISTRO != 'humble'">b2_nav_execution</exec_depend>
  <exec_depend condition="$ROS_DISTRO != 'humble'">b2_nav_experiment</exec_depend>
  <exec_depend condition="$ROS_DISTRO != 'humble'">b2_nav_search</exec_depend>
  <exec_depend condition="$ROS_DISTRO != 'humble'">b2_nav_task</exec_depend>
  <!-- Legacy simulation remains on the Humble device host. -->
  <exec_depend condition="$ROS_DISTRO == 'humble'">b2_nav_sim</exec_depend>
  <exec_depend>b2_nav_twin</exec_depend>
  <exec_depend condition="$ROS_DISTRO == 'humble'">gazebo_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>lifecycle_msgs</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>nav2_common</exec_depend>
  <exec_depend>nav2_controller</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>nav2_amcl</exec_depend>
  <exec_depend>nav2_planner</exec_depend>
  <exec_depend>nav2_smoother</exec_depend>
  <exec_depend>nav2_behaviors</exec_depend>
  <exec_depend>nav2_bt_navigator</exec_depend>
  <exec_depend>nav2_waypoint_follower</exec_depend>
  <exec_depend>nav2_velocity_smoother</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend condition="$ROS_DISTRO == 'humble'">turtlebot3_gazebo</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
